[Unit]
Description=Eyada Clinic (Node.js, zero dependencies)
After=network.target

[Service]
Type=simple
User=eyada
Group=eyada
WorkingDirectory=/opt/eyada-clinic
EnvironmentFile=/opt/eyada-clinic/.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
# graceful shutdown (SIGTERM triggers backup + flush)
KillSignal=SIGTERM
TimeoutStopSec=30
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/eyada-clinic/data

[Install]
WantedBy=multi-user.target
