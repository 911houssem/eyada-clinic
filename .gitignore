# runtime output
*.log
*.out
*.err
ui-out.txt
ui-err.txt

# artifacts written by the suites
tests/booking-dom*.html
tests/*-out.txt
tests/*-err.txt

# live database (holds account credentials; the server seeds demo data
# automatically on first run, so it is never committed)
data/db.json

# live session store (only SHA-256 hashes of tokens; per-host, never committed)
data/sessions.json
data/sessions.json.tmp

# audit trail, runtime backups and the rotated server log
data/audit.log
data/audit.log.1
data/backups/
data/server.log
data/server.log.1

# database snapshots taken by the flush/repair helpers
data/*.tmp
data/*.backup-*
data/*.pre-purge-*

# superseded bundle copies
_next/static/chunks/*.orig
_next/static/chunks/*.orig2

# dependencies / os
node_modules/
.DS_Store
Thumbs.db

# secrets: never commit a filled env file (only .env.example is tracked)
.env
.env.local
.env.*.local
!.env.example

# test coverage / packaging leftovers
coverage/
npm-debug.log*
*.tgz
