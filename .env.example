# Eyada Clinic — copy to .env and fill in. NEVER commit the filled file.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
ORIGIN=https://your-domain.example
TRUST_PROXY=0

# First site owner (prod boot refuses without one, unless --create-owner)
OWNER_USERNAME=
OWNER_PASSWORD=
OWNER_NAME=
OWNER_EMAIL=

# At-rest encryption (REQUIRED in production) — long random secrets
ENCRYPTION_KEY=
BACKUP_ENCRYPT_KEY=

# Public registration: open | invite | closed (prod default: closed)
REGISTRATION=
REGISTER_MAX_PER_HOUR=3
MAX_PENDING_CLINICS=20

# Outbound mail relay (optional; enables the smtp notifier channel)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_REJECT_UNAUTHORIZED=0  # ONLY for relays with self-signed certs

# Payment webhooks (mock/transfer providers; real providers need their docs)
PAYMENTS_WEBHOOK_SECRET=

# Notifiers / misc
NOTIFY_CHANNEL=console
PUBLIC_URL=
TRASH_TTL_DAYS=30
FILE_MAX_BYTES=3145728
RESET_MAX=
